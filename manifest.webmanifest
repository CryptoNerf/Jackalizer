{
    "name": "Jackalizer",
    "short_name": "Jackalizer",
    "description": "Пикселизация, размытие, глитч и шакализация любой области фото",
    "lang": "ru",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#A4CFEC",
    "theme_color": "#A4CFEC",
    "icons": [
        { "src": "img/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "img/icon-512.png", "sizes": "512x512", "type": "image/png" }
    ],
    "share_target": {
        "action": "/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [{ "name": "image", "accept": ["image/*"] }]
        }
    },
    "file_handlers": [{
        "action": "/",
        "accept": { "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".avif"] }
    }]
}
